rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper para buscar dados do usuário logado
    function getUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    
    // Verifica se o usuário pertence à igreja especificada
    function userBelongsToChurch(igrejaId) {
      return request.auth != null 
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && getUsuario().igrejaId == igrejaId;
    }
    
    // Verifica se o usuário pode acessar uma determinada unidade
    function userCanAccessUnidade(igrejaId, unidadeId) {
      return userBelongsToChurch(igrejaId) && (
        getUsuario().nivelAcesso == "full" ||
        getUsuario().unidadeId == unidadeId ||
        (getUsuario().nivelAcesso == "admin" && (
          unidadeId == getUsuario().unidadeId ||
          (exists(/databases/$(database)/documents/igrejas/$(igrejaId)/unidades/$(unidadeId)) &&
           get(/databases/$(database)/documents/igrejas/$(igrejaId)/unidades/$(unidadeId)).data.unidadePaiId == getUsuario().unidadeId)
        ))
      );
    }

    // Coleção raiz de usuários
    match /usuarios/{userId} {
      // Usuário pode ler/escrever seu próprio documento (pelo UID ou pelo telefone de login)
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.phone_number == userId);
      
      // Administrador da mesma igreja pode ler/escrever outros usuários da mesma igreja
      allow read, write: if request.auth != null 
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && getUsuario().igrejaId == resource.data.igrejaId
        && getUsuario().nivelAcesso in ["admin", "full"];
        
      allow create: if request.auth != null;
    }
    
    // Coleção principal de igrejas
    match /igrejas/{igrejaId} {
      allow read: if userBelongsToChurch(igrejaId);
      allow write: if userBelongsToChurch(igrejaId) && getUsuario().nivelAcesso in ["admin", "full"];
      allow create: if request.auth != null;
      
      // Unidades
      match /unidades/{unidadeId} {
        allow read: if userBelongsToChurch(igrejaId);
        allow write: if userBelongsToChurch(igrejaId) && getUsuario().nivelAcesso in ["admin", "full"];
        
        // Membros
        match /membros/{membroId} {
          allow read: if userCanAccessUnidade(igrejaId, unidadeId);
          allow write: if userCanAccessUnidade(igrejaId, unidadeId) && getUsuario().nivelAcesso in ["admin", "full"];
          // Permite criação pública/anônima (link público de cadastro via QR Code)
          allow create: if true;
        }
        
        // Visitantes
        match /visitantes/{visitanteId} {
          allow read: if userCanAccessUnidade(igrejaId, unidadeId);
          allow write: if userCanAccessUnidade(igrejaId, unidadeId) && getUsuario().nivelAcesso in ["admin", "full"];
          // Permite criação pública/anônima
          allow create: if true;
        }
        
        // Grupos
        match /grupos/{grupoId} {
          allow read: if userCanAccessUnidade(igrejaId, unidadeId);
          allow write: if userCanAccessUnidade(igrejaId, unidadeId) && getUsuario().nivelAcesso in ["admin", "full"];
        }
        
        // Acompanhamentos
        match /acompanhamentos/{acompId} {
          allow read: if userCanAccessUnidade(igrejaId, unidadeId);
          allow write: if userCanAccessUnidade(igrejaId, unidadeId) && getUsuario().nivelAcesso in ["admin", "full"];
        }
        
        // Famílias
        match /familias/{familiaId} {
          allow read: if userCanAccessUnidade(igrejaId, unidadeId);
          allow write: if userCanAccessUnidade(igrejaId, unidadeId) && getUsuario().nivelAcesso in ["admin", "full"];
        }
      }
    }
  }
}
